---
import { SITE } from '../config/site';
---
<footer class="bg-white border-t mt-12">
  <div class="max-w-6xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-3 gap-8">
    <div>
      <div class="flex items-center gap-3">
        <svg class="w-8 h-8 text-[var(--color-brand)]" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 9l9-6 9 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 9v11h14V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span class="text-lg font-bold">{SITE.name}</span>
      </div>
      <p class="mt-3 text-sm text-[var(--color-muted)] max-w-sm">{SITE.description}</p>
    </div>

    <div>
      <h4 class="font-semibold mb-3">Serviços</h4>
      <ul class="space-y-2 text-sm">
        <li><a href="/hidraulica/" class="hover:underline">Hidráulica</a></li>
        <li><a href="/eletrica/" class="hover:underline">Elétrica</a></li>
        <li><a href="/reformas/" class="hover:underline">Reformas</a></li>
        <li><a href="/pintura/" class="hover:underline">Pintura</a></li>
        <li><a href="/pisos/" class="hover:underline">Pisos</a></li>
        <li><a href="/construcao/" class="hover:underline">Construção</a></li>
      </ul>
    </div>

    <div>
      <h4 class="font-semibold mb-3">Links</h4>
      <ul class="space-y-2 text-sm">
        <li><a href="/blog/" class="hover:underline">Blog</a></li>
        <li><a href="/sobre/" class="hover:underline">Sobre</a></li>
        <li><a href="/privacidade/" class="hover:underline">Privacidade</a></li>
        <li><a href="/termos/" class="hover:underline">Termos</a></li>
        <li class="mt-3"><a href={SITE.whatsapp.url} class="font-medium">{SITE.whatsapp.display}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t py-4 text-center text-sm text-[var(--color-muted)]">
    © {new Date().getFullYear()} {SITE.name} — Todos os direitos reservados.
  </div>
</footer>

