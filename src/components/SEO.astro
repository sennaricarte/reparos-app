---
import { SITE } from '../config/site';
import { getImage } from 'astro:assets';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: any;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex,
} = Astro.props as Props;

// normalize canonical: absolute and trailing slash unless path ends with a file extension
function normalizeCanonical(c?: string) {
  const base = SITE.url;
  try {
    const u = new URL(c ?? base, base);
    const parts = u.pathname.split('/').filter(Boolean);
    const last = parts.length ? parts[parts.length - 1] : '';
    const hasExt = /\.[a-z0-9]{1,6}$/i.test(last);
    if (!hasExt && !u.pathname.endsWith('/')) {
      u.pathname = u.pathname + '/';
    }
    return u.toString();
  } catch {
    return undefined;
  }
}

const canonicalAbs = normalizeCanonical(canonical ?? SITE.url);
const ogUrl = canonicalAbs;

let ogImage = undefined;
let ogImageWidth = undefined;
let ogImageHeight = undefined;
let ogImageAlt = undefined;
if (image) {
  if (typeof image === 'string') {
    ogImage = image;
  } else {
    // ImageMetadata -> generate 1200x630 jpg
    try {
      const generated = await getImage(image, { width: 1200, height: 630, format: 'jpg' });
      ogImage = generated.src;
      ogImageWidth = generated.width;
      ogImageHeight = generated.height;
    } catch {
      // fallback: ignore
    }
  }
} else {
  // no image provided: try to use generated og-default.png if available; fall back to SITE url path
  let ogDefault = null;
  try {
    ogDefault = await import('../assets/og-default.png');
  } catch {
    ogDefault = null;
  }
  if (ogDefault && ogDefault.default) {
    try {
      const generated = await getImage(ogDefault.default, { width: 1200, height: 630, format: 'jpg' });
      ogImage = generated.src;
      ogImageWidth = generated.width;
      ogImageHeight = generated.height;
    } catch {
      ogImage = SITE.url.replace(/\/$/, '') + '/assets/og-default.png';
      ogImageWidth = 1200;
      ogImageHeight = 630;
    }
  } else {
    ogImage = SITE.url.replace(/\/$/, '') + '/assets/og-default.png';
    ogImageWidth = 1200;
    ogImageHeight = 630;
  }
  ogImageAlt = `${SITE.name} — Hidráulica, Elétrica e Reformas em São Paulo`;
}
---
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex,nofollow" /> : null}
<link rel="canonical" href={canonicalAbs ?? SITE.url} />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Open Graph -->
<meta property="og:locale" content="pt_BR" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:type" content={type} />
<meta property="og:url" content={ogUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{ogImage ? <meta property="og:image" content={ogImage} /> : null}
{ogImageAlt ? <meta property="og:image:alt" content={ogImageAlt} /> : null}
{ogImageWidth ? <meta property="og:image:width" content={String(ogImageWidth)} /> : null}
{ogImageHeight ? <meta property="og:image:height" content={String(ogImageHeight)} /> : null}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage ? <meta name="twitter:image" content={ogImage} /> : null}
{ogImageAlt ? <meta name="twitter:image:alt" content={ogImageAlt} /> : null}

