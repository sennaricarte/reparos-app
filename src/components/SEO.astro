---
import { SITE } from '../config/site';
import { getImage } from 'astro:assets';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: any;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex,
} = Astro.props as Props;

// canonical must be absolute and have trailing slash
function normalizeCanonical(c?: string) {
  if (!c) return undefined;
  try {
    const u = new URL(c, SITE.url);
    let p = u.pathname;
    if (!p.endsWith('/')) p = p + '/';
    u.pathname = p;
    return u.toString();
  } catch {
    return undefined;
  }
}

const canonicalAbs = normalizeCanonical(canonical);

let ogUrl = canonicalAbs ?? SITE.url;
if (!ogUrl.endsWith('/')) ogUrl = ogUrl + '/';

let ogImage = undefined;
let ogImageWidth = undefined;
let ogImageHeight = undefined;
if (image) {
  if (typeof image === 'string') {
    ogImage = image;
  } else {
    // ImageMetadata -> generate 1200x630 jpg
    try {
      const generated = await getImage(image, { width: 1200, height: 630, format: 'jpg' });
      ogImage = generated.src;
      ogImageWidth = generated.width;
      ogImageHeight = generated.height;
    } catch {
      // fallback: ignore
    }
  }
}
---
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex,nofollow" /> : null}
<link rel="canonical" href={canonicalAbs ?? SITE.url} />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Open Graph -->
<meta property="og:locale" content="pt_BR" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:type" content={type} />
<meta property="og:url" content={ogUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{ogImage ? <meta property="og:image" content={ogImage} /> : null}
{ogImageWidth ? <meta property="og:image:width" content={String(ogImageWidth)} /> : null}
{ogImageHeight ? <meta property="og:image:height" content={String(ogImageHeight)} /> : null}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage ? <meta name="twitter:image" content={ogImage} /> : null}

