---
import { SITE } from '../config/site';
import { getImage } from 'astro:assets';
import ogDefault from '../assets/og-default.png';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: any;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex,
} = Astro.props as Props;

// normalize canonical: absolute and trailing slash unless path ends with a file extension
function normalizeCanonical(c?: string) {
  const base = SITE.url;
  try {
    const u = new URL(c ?? base, base);
    const parts = u.pathname.split('/').filter(Boolean);
    const last = parts.length ? parts[parts.length - 1] : '';
    const hasExt = /\.[a-z0-9]{1,6}$/i.test(last);
    if (!hasExt && !u.pathname.endsWith('/')) {
      u.pathname = u.pathname + '/';
    }
    return u.toString();
  } catch {
    return undefined;
  }
}

const canonicalAbs = normalizeCanonical(canonical ?? SITE.url);
const ogUrl = canonicalAbs;

let ogImage = undefined;
let ogImageWidth = undefined;
let ogImageHeight = undefined;
let ogImageAlt = undefined;

async function generateOgFromSrc(src: string | URL) {
  try {
    const generated = await getImage({ src: src }, { width: 1200, height: 630, format: 'jpg' } as any);
    // generated.src is typically a path like '/_astro/xyz.jpg' — make absolute
    const abs = new URL(generated.src, SITE.url).toString();
    return { src: abs, width: generated.width, height: generated.height };
  } catch {
    return null;
  }
}

if (image) {
  // image can be string or ImageMetadata. Normalize to a src and always generate JPG via getImage
  if (typeof image === 'string') {
    const res = await generateOgFromSrc(image);
    if (res) {
      ogImage = res.src;
      ogImageWidth = res.width;
      ogImageHeight = res.height;
    } else {
      ogImage = new URL(image, SITE.url).toString();
      ogImageWidth = 1200;
      ogImageHeight = 630;
    }
  } else {
    const res = await generateOgFromSrc(image);
    if (res) {
      ogImage = res.src;
      ogImageWidth = res.width;
      ogImageHeight = res.height;
    }
  }
} else {
  // use imported ogDefault
  const res = await generateOgFromSrc(ogDefault);
  if (res) {
    ogImage = res.src;
    ogImageWidth = res.width;
    ogImageHeight = res.height;
  } else {
    ogImage = new URL('/assets/og-default.png', SITE.url).toString();
    ogImageWidth = 1200;
    ogImageHeight = 630;
  }
  ogImageAlt = `${SITE.name} — Hidráulica, Elétrica e Reformas em São Paulo`;
}
---
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex,nofollow" /> : null}
<link rel="canonical" href={canonicalAbs ?? SITE.url} />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Open Graph -->
<meta property="og:locale" content="pt_BR" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:type" content={type} />
<meta property="og:url" content={ogUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{ogImage ? <meta property="og:image" content={ogImage} /> : null}
{ogImageAlt ? <meta property="og:image:alt" content={ogImageAlt} /> : null}
{ogImageWidth ? <meta property="og:image:width" content={String(ogImageWidth)} /> : null}
{ogImageHeight ? <meta property="og:image:height" content={String(ogImageHeight)} /> : null}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage ? <meta name="twitter:image" content={ogImage} /> : null}
{ogImageAlt ? <meta name="twitter:image:alt" content={ogImageAlt} /> : null}

