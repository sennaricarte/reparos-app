---
import { SITE } from '../config/site';
---
<style>
.wp-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 56px;
  height: 56px;
  border-radius: 9999px;
  background: #25D366;
  color: white;
  box-shadow: 0 6px 18px rgba(0,0,0,0.12);
  position: fixed;
  right: 1rem;
  bottom: env(safe-area-inset-bottom, 1rem);
  z-index: 50;
  transition: background .15s ease;
}
.wp-button:hover { background: #1EBE5A; }
.wp-button svg path { fill: white !important; }
</style>
<a
  href={SITE.whatsapp.url}
  target="_blank"
  rel="noopener"
  aria-label="Falar no WhatsApp"
  class="fixed right-4 bottom-[env(safe-area-inset-bottom,16px)] z-50 wp-button"
>
  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <path d="M20.52 3.48A11.9 11.9 0 0012.03 0C5.42 0 .24 5.18.24 11.79c0 2.08.54 4.12 1.58 5.93L0 24l6.48-1.66A11.84 11.84 0 0012.03 24c6.61 0 11.79-5.18 11.79-11.79 0-3.15-1.23-6.11-3.3-8.73z" fill="white"/>
    <path d="M17.2 14.1c-.28-.14-1.66-.82-1.92-.9-.26-.09-.45-.14-.64.14-.19.28-.73.9-.9 1.09-.16.19-.33.21-.61.07-.28-.14-1.19-.44-2.27-1.4-.84-.75-1.4-1.68-1.56-1.96-.16-.28-.02-.43.12-.57.12-.12.28-.32.42-.48.14-.16.19-.28.28-.46.09-.19.05-.35-.02-.49-.07-.14-.64-1.54-.88-2.12-.23-.56-.47-.48-.64-.49-.16-.01-.35-.01-.54-.01-.19 0-.5.07-.76.35-.26.28-.98.96-.98 2.34s1.01 2.72 1.15 2.91c.14.19 1.98 3.02 4.8 4.24 1.11.48 1.98.76 2.66.97.84.27 1.61.23 2.22.14.68-.11 1.66-.68 1.9-1.33.24-.65.24-1.22.17-1.33-.07-.12-.26-.19-.54-.33z" fill="white"/>
  </svg>
</a>

