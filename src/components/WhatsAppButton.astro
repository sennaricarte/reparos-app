---
import { SITE } from '../config/site';
---
<style>
.wp-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 56px;
  height: 56px;
  border-radius: 9999px;
  background: #25D366;
  color: white;
  box-shadow: 0 6px 18px rgba(0,0,0,0.12);
  position: fixed;
  right: 1rem;
  bottom: env(safe-area-inset-bottom, 1rem);
  z-index: 50;
  transition: background .15s ease;
}
.wp-button:hover { background: #1EBE5A; }
.wp-button svg path { fill: white !important; }
</style>
<a
  href={SITE.whatsapp.url}
  target="_blank"
  rel="noopener"
  aria-label="Falar no WhatsApp"
  class="fixed right-4 bottom-[env(safe-area-inset-bottom,16px)] z-50 wp-button"
>
  <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" role="img">
    <path fill="white" d="M12.04 2C6.13 2 1.57 6.56 1.57 12.47c0 2.2.66 4.24 1.8 6.03L2 22l3.66-1.08c1.68 1.02 3.7 1.55 5.84 1.55 5.91 0 10.47-4.56 10.47-10.47S17.95 2 12.04 2zm4.52 14.31c-.25.69-1.47 1.33-2.03 1.42-.53.08-1.14.12-1.8-.08-1.31-.36-2.53-1.39-3.34-2.54-.64-.94-1.07-2.07-1.1-3.19-.05-1.64.76-2.97 1.86-3.9.97-.79 2.11-1.11 3.19-1.05 1.01.06 1.98.42 2.76 1.09.77.67 1.28 1.6 1.34 2.66.07 1.33-.28 2.63-.75 3.35zM15.1 9.55c-.15-.18-.38-.27-.61-.24-.24.03-.45.14-.64.32-.25.24-.7.68-.81.78-.1.11-.22.13-.39.05-.25-.12-1.1-.48-1.99-.98-.43-.24-.9-.09-1.14.32-.17.28-.55.94-.67 1.13-.1.19-.01.42.31.69.22.18.5.43.72.62.21.19.45.4.69.62.1.09.2.18.29.28.1.11.08.26-.06.38-.46.37-1.1.5-1.91.31-.4-.09-2.39-.89-3.5-1.63-.18-.12-.35-.22-.49-.31-.15-.1-.35-.18-.6-.12-.36.08-1.69.49-1.96.57-.41.14-.78.42-1.02.81-.06.11-.11.24-.14.37-.05.19.02.39.18.52.34.3 1.21 1.08 2.9 1.77 1.86.76 3.42 1.12 4.84 1.06 1.2-.05 2.18-.49 2.88-1.12.79-.72 1.28-1.62 1.37-2.58.1-1.2-.24-2.64-1.04-3.68z"/>
