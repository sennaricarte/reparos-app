---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Schema from '../components/Schema.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { SITE } from '../config/site';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';

const { title, description, canonical, image, type, publishedTime, modifiedTime, noindex } = Astro.props;

// Organization & Website JSON-LD
const siteUrl = SITE.url.endsWith('/') ? SITE.url : SITE.url + '/';
const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": SITE.name,
  "url": siteUrl,
  "logo": siteUrl + 'favicon.svg',
  "foundingDate": "2015",
  "contactPoint": [{
    "@type": "ContactPoint",
    "contactType": "customer service",
    "telephone": `+${SITE.whatsapp.number}`
  }]
};
const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "url": siteUrl,
  "name": SITE.name
};
---
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      noindex={noindex}
    />

    <slot name="head" />
  </head>
  <body class="antialiased min-h-screen bg-white text-[var(--color-ink)]">
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-[var(--color-brand)] focus:text-white focus:rounded-md">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />

    <!-- JSON-LD always included -->
    <Schema data={org} />
    <Schema data={websiteLd} />
  </body>
</html>

