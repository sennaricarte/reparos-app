---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Página não encontrada" description="Página não encontrada" noindex>
  <div class="max-w-3xl mx-auto px-4 py-20 text-center">
    <h1 class="text-3xl font-bold">404 — Página não encontrada</h1>
    <p class="mt-4 text-[var(--color-muted)]">Desculpe, não encontramos a página solicitada.</p>
    <p class="mt-6">
      <a href="/" class="mr-4">Ir para a página inicial</a>
      <a href="/blog/">Ir para o blog</a>
    </p>
  </div>
</BaseLayout>

