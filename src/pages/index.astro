---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);
posts.sort((a,b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));
const HOME_POSTS = 12;
const recent = posts.slice(0, HOME_POSTS);
---

<BaseLayout title="Reparos Profissionais em São Paulo" description={SITE.description} canonical={SITE.url}>
  <div class="max-w-6xl mx-auto px-4">

    <!-- Hero -->
    <section class="py-16">
      <div class="text-center">
        <h1 class="text-4xl font-black">Reparos Profissionais em São Paulo</h1>
        <p class="mt-4 text-lg text-[var(--color-muted)]">Descreva seu problema pelo WhatsApp e receba indicação de profissionais de hidráulica, elétrica e reformas em São Paulo.</p>
        <div class="mt-6 flex justify-center gap-4">
          <a href={SITE.whatsapp.url} target="_blank" rel="noopener" class="px-6 py-3 rounded-md bg-[var(--color-brand)] text-white font-semibold">Falar no WhatsApp</a>
          <a href="/sobre/" class="px-6 py-3 rounded-md text-[var(--color-brand)] border border-[var(--color-border)]">Sobre</a>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section id="servicos" class="py-12">
      <h2 class="text-2xl font-semibold mb-6">Nossos Serviços</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-6">
        <article class="p-6 border rounded">
          <div class="w-10 h-10 mb-3 flex items-center justify-center bg-[var(--color-brand)] text-white rounded">💧</div>
          <h3 class="font-bold">Hidráulica</h3>
          <p class="text-sm text-[var(--color-muted)] mt-2">Vazamentos, desentupimento e manutenção hidráulica.</p>
          <a href="/hidraulica/" class="mt-3 inline-block text-sm text-[var(--color-brand)]">Ver mais</a>
        </article>

        <article class="p-6 border rounded">
          <div class="w-10 h-10 mb-3 flex items-center justify-center bg-[var(--color-brand)] text-white rounded">⚡</div>
          <h3 class="font-bold">Elétrica</h3>
          <p class="text-sm text-[var(--color-muted)] mt-2">Instalação e manutenção elétrica residencial e comercial.</p>
          <a href="/eletrica/" class="mt-3 inline-block text-sm text-[var(--color-brand)]">Ver mais</a>
        </article>

        <article class="p-6 border rounded">
          <div class="w-10 h-10 mb-3 flex items-center justify-center bg-[var(--color-brand)] text-white rounded">🛠️</div>
          <h3 class="font-bold">Reformas</h3>
          <p class="text-sm text-[var(--color-muted)] mt-2">Reformas de apartamentos, casas e imóveis comerciais.</p>
          <a href="/reformas/" class="mt-3 inline-block text-sm text-[var(--color-brand)]">Ver mais</a>
        </article>

        <article class="p-6 border rounded">
          <div class="w-10 h-10 mb-3 flex items-center justify-center bg-[var(--color-brand)] text-white rounded">🎨</div>
          <h3 class="font-bold">Pintura</h3>
          <p class="text-sm text-[var(--color-muted)] mt-2">Pintura residencial e comercial.</p>
          <a href="/pintura/" class="mt-3 inline-block text-sm text-[var(--color-brand)]">Ver mais</a>
        </article>

        <article class="p-6 border rounded">
          <div class="w-10 h-10 mb-3 flex items-center justify-center bg-[var(--color-brand)] text-white rounded">🏗️</div>
          <h3 class="font-bold">Pisos</h3>
          <p class="text-sm text-[var(--color-muted)] mt-2">Porcelanato, vinílico, laminado e cerâmica.</p>
          <a href="/pisos/" class="mt-3 inline-block text-sm text-[var(--color-brand)]">Ver mais</a>
        </article>

        <article class="p-6 border rounded">
          <div class="w-10 h-10 mb-3 flex items-center justify-center bg-[var(--color-brand)] text-white rounded">🏠</div>
          <h3 class="font-bold">Construção</h3>
          <p class="text-sm text-[var(--color-muted)] mt-2">Obras e construção residencial e comercial.</p>
          <a href="/construcao/" class="mt-3 inline-block text-sm text-[var(--color-brand)]">Ver mais</a>
        </article>
      </div>
    </section>

    <!-- Why choose -->
    <section class="py-12">
      <h2 class="text-2xl font-semibold mb-6">Como funciona</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 border rounded text-center">
          <div class="mb-3 text-[var(--color-brand)]">💬</div>
          <h3 class="font-bold">1. Descreva</h3>
          <p class="text-sm text-[var(--color-muted)] mt-2">Conte o que você precisa pelo WhatsApp.</p>
        </div>
        <div class="p-6 border rounded text-center">
          <div class="mb-3 text-[var(--color-brand)]">🤝</div>
          <h3 class="font-bold">2. Receba a indicação</h3>
          <p class="text-sm text-[var(--color-muted)] mt-2">Receba indicação de profissionais para o seu caso.</p>
        </div>
        <div class="p-6 border rounded text-center">
          <div class="mb-3 text-[var(--color-brand)]">⚖️</div>
          <h3 class="font-bold">3. Compare e decida</h3>
          <p class="text-sm text-[var(--color-muted)] mt-2">Peça orçamento, compare e combine prazo e garantia por escrito.</p>
        </div>
      </div>
    </section>

    <!-- Recent posts -->
    <section class="py-12">
      <h2 class="text-2xl font-semibold mb-6">Posts recentes</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {recent.map(p => <PostCard post={p} />)}
      </div>
      <p class="mt-8 text-center"><a href="/blog/" class="inline-block px-6 py-3 rounded-md text-[var(--color-brand)] border border-[var(--color-border)] font-semibold">Ver todos os artigos</a></p>
    </section>

    <!-- Final CTA -->
    <section class="py-12 mt-8" style={`background: var(--color-brand); color: white;`}>
      <div class="max-w-6xl mx-auto px-4 py-12 text-center">
        <h2 class="text-2xl font-bold">Precisa de ajuda agora?</h2>
        <p class="mt-2 text-sm">Descreva o que precisa pelo WhatsApp e receba indicação de profissionais.</p>
        <a href={SITE.whatsapp.url} target="_blank" rel="noopener" class="mt-4 inline-block px-6 py-3 bg-white text-[var(--color-brand)] font-semibold rounded">Falar no WhatsApp</a>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context":"https://schema.org",
      "@type":"WebPage",
      "name":"Home",
      "url": SITE.url,
      "description": SITE.description,
      "breadcrumb": {
        "@type":"BreadcrumbList",
        "itemListElement":[
          {"@type":"ListItem","position":1,"name":"Início","item":SITE.url}
        ]
      }
    })} />

  </div>
</BaseLayout>
